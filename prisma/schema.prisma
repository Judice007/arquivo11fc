// Arquivo 11 — Prisma schema
//
// PostgreSQL (produção e desenvolvimento). O projeto rodou em SQLite durante o
// desenvolvimento inicial do MVP; migrado para Postgres ao publicar no Vercel
// (SQLite/better-sqlite3 não funciona em ambiente serverless). Nenhum tipo/recurso
// específico de um único conector é usado aqui (sem `Json` com defaults dependentes
// do conector), então o schema seria portável de volta a outro banco SQL se preciso.
//
// Tipos de uniforme (HOME/AWAY/THIRD/GK/FOURTH/SPECIAL/TRAINING) continuam modelados
// como `String` validada em TypeScript (ver src/lib/kit-types.ts) em vez de `enum`
// nativo do Prisma — mantém paridade com o período em que o dev local usava SQLite,
// que não suporta enum nativo. Pode ser promovido para enum do Postgres no futuro.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Classifica a PROVENIÊNCIA de uma imagem (não o ângulo — isso é `type`/`KitImage.type`):
// - ARCHIVE_PHOTO: foto real do uniforme com autorização/licença/origem adequada.
// - OFFICIAL_REFERENCE: material documental de terceiros (loja, fabricante, imprensa).
//   Nunca é escolhida automaticamente como imagem principal do acervo.
// - DIGITAL_RECREATION: recriação digital para padronização visual do Arquivo 11,
//   possivelmente baseada em referências. Pode ser imagem principal quando fornecida
//   explicitamente pelo admin, mas a interface pública sinaliza que é uma recriação.
// Nativo do Postgres agora (não SQLite) — pode ser enum sem os problemas de portabilidade
// que levaram KitType a ficar como String.
enum ImageSourceType {
  ARCHIVE_PHOTO
  OFFICIAL_REFERENCE
  DIGITAL_RECREATION
}

model Country {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  continent String
  flagUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs         Club[]
  nationalTeams NationalTeam[]
  manufacturers Manufacturer[]
  competitions  Competition[]

  @@index([continent])
}

model Club {
  id           String   @id @default(cuid())
  name         String
  fullName     String
  slug         String   @unique
  countryId    String
  city         String?
  foundedYear  Int?
  crestUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  kits    Kit[]

  @@index([countryId])
}

model NationalTeam {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  countryId String
  crestUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  kits    Kit[]

  @@index([countryId])
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  countryId String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  kits    Kit[]

  @@index([countryId])
}

model Sponsor {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kits Kit[]
}

model Competition {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  countryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  kits    KitCompetition[]

  @@index([countryId])
}

// Um Kit pertence a UM clube OU UMA seleção, nunca os dois (clubId/nationalTeamId
// são mutuamente exclusivos). SQLite não tem uma forma elegante de expor um CHECK
// constraint via Prisma, então essa regra é validada na camada de aplicação
// (ver src/lib/validations/kit.ts). Ao migrar para Postgres, considerar adicionar:
//   ALTER TABLE "Kit" ADD CONSTRAINT kit_owner_xor
//     CHECK (num_nonnulls("clubId", "nationalTeamId") = 1);
model Kit {
  id             String   @id @default(cuid())
  clubId         String?
  nationalTeamId String?

  seasonStart Int
  seasonEnd   Int
  type        String // HOME | AWAY | THIRD | GK | FOURTH | SPECIAL | TRAINING — ver src/lib/kit-types.ts

  manufacturerId  String?
  mainSponsorId   String?

  primaryColor   String?
  secondaryColor String?
  description    String?

  // Imagens do acervo — SÓ arquivos padronizados fornecidos pelo admin (camisa
  // isolada, frente/costas). Nunca preenchidas automaticamente a partir de uma
  // fonte externa (ver sourceUrl abaixo). É o que aparece como imagem principal
  // do card e da ficha do uniforme.
  mainImageUrl        String? // frente padronizada
  mainImageSourceType ImageSourceType @default(DIGITAL_RECREATION)
  backImageUrl        String? // costas padronizada
  backImageSourceType ImageSourceType @default(DIGITAL_RECREATION)

  // Fontes e referências — material documental de terceiros (loja oficial, imprensa,
  // etc.), nunca usado diretamente como imagem do acervo. `imageLicense` funciona
  // como a "observação de uso" (ex.: "uso editorial/referência, direitos de terceiros").
  sourceUrl    String? // URL oficial
  sourceOwner  String? // titular/origem (ex.: "Loja Oficial do Flamengo / adidas")
  photographer String? // fotógrafo, quando conhecido
  imageCredit  String? // crédito
  imageLicense String? // observação de uso

  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club         Club?         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  nationalTeam NationalTeam? @relation(fields: [nationalTeamId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  mainSponsor  Sponsor?      @relation(fields: [mainSponsorId], references: [id], onDelete: SetNull)

  images       KitImage[]
  competitions KitCompetition[]

  @@index([clubId])
  @@index([nationalTeamId])
  @@index([manufacturerId])
  @@index([seasonStart, seasonEnd])
  @@index([type])
}

model KitImage {
  id           String          @id @default(cuid())
  kitId        String
  imageUrl     String
  type         String // frente | costas | detalhe | outra — texto livre curto por enquanto
  sourceType   ImageSourceType @default(DIGITAL_RECREATION)
  sourceUrl    String?
  photographer String?
  credit       String?
  license      String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  kit Kit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId])
}

// Tabela de junção explícita (em vez de m2m implícito do Prisma) para poder
// evoluir com campos extras (ex.: "uniforme usado na final") sem migração disruptiva.
model KitCompetition {
  kitId         String
  competitionId String

  kit         Kit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([kitId, competitionId])
  @@index([competitionId])
}
